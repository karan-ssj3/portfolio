# Apache/LiteSpeed rules for the React SPA.
# Vite copies this file from public/ into dist/ on every build.

# Deny access to the FTP deploy state file.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

RewriteEngine On
RewriteBase /

# Force HTTPS (permanent redirect).
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# SPA fallback: deep links like /projects that are not an existing file
# (-f) or directory (-d) are rewritten to /index.html so React Router
# can handle them.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# --- Caching ---
# Vite emits content-hashed filenames under /assets/, so those files never
# change and can be cached for a year. index.html must always be revalidated
# so new deploys show up immediately.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets: 1 year, immutable.
  <FilesMatch "\.(css|js|mjs|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html: no-cache.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
